# Copy to .env and fill in real values. NEVER commit .env (it is git-ignored).
# Placeholders only — no real credentials belong in this file.

# Real process environment variables take precedence over this file.
# Check your settings without starting the server: .venv\Scripts\python.exe run_api.py --check-config

# REQUIRED — PostgreSQL (use a dedicated least-privilege role on localhost; see docs/remediation/PHASE7_SECURITY_LOCAL_DEPLOYMENT.md)
DATABASE_URL=postgresql://rag_app:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/rag_db

# PROVIDER-SPECIFIC — LLM (Gemini is the only implemented provider). Needed for chat/LLM
# calls only; the API and services import and start without it.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Optional model overrides (defaults are defined in services/llm_config.py)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash

# OPTIONAL — retrieval / ingestion / performance knobs (defaults and the full list in
# services/retrieval_config.py; an invalid number makes startup fail with a clear message)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# MAX_PDF_SIZE_MB=50
# MAX_PDF_PAGES=500
# RAG_PERF_METRICS=0

# OPTIONAL — Local API (Phase 7). Read from this file (loaded by backend/config.py before any setting).
# The API token is generated automatically into your user profile on first start
# (run_api.py --show-token-path). Setting RAG_API_TOKEN here instead stores it in plain text.
# RAG_API_TOKEN=
# RAG_API_TOKEN_FILE=
# Explicit browser origins allowed to call the API (no "*"):
# RAG_API_CORS_ORIGINS=http://localhost:5173
# Extra Host-header names (only with run_api.py --allow-non-loopback):
# RAG_API_ALLOWED_HOSTS=
# Interactive API docs at /api/v1/docs (schema only):
# RAG_API_DOCS=1
