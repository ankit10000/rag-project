# Copy outside the repository to /srv/rag/config/deployment.env (0600).
# No credential value belongs in this file or an image.
COMPOSE_PROJECT_NAME=rag-demo
RAG_DOMAIN=rag.example.com
# Optional hostname mode: retain a trusted HTTPS redirect from the static IP.
# RAG_STATIC_IP=203.0.113.10
# RAG_CADDY_CONFIG=Caddyfile.hostname
ACME_EMAIL=owner@example.com
RAG_DATABASE_NAME=rag_v2_demo
RAG_ADMIN_ROLE=rag_admin
RAG_STATE_DIR=/srv/rag/state
RAG_MODELS_DIR=/srv/rag/models
RAG_SECRETS_DIR=/srv/rag/secrets
RAG_BACKEND_IMAGE=rag-v2-backend:local
RAG_FRONTEND_IMAGE=rag-v2-frontend:local
RAG_CADDY_IMAGE=caddy:2.11.9-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
# Pin reviewed image digests before upload; the defaults in compose.yaml are pinned.
GEMINI_MODEL=gemini-3.5-flash-lite
# Provider fallback is disabled for predictable demonstration spend.
GEMINI_FALLBACK_MODELS=
