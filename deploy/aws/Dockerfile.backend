# syntax=docker/dockerfile:1.7
# Build on the development machine, then export the image to the host. No model
# weights, secrets, evaluation fixtures or user uploads belong in this image.
ARG PYTHON_IMAGE=python:3.14.10-slim-bookworm@sha256:3fe1a0b6c2d6b2ebb572906cdabeca75aeb558c0c17db5ffefbcf8094871c32b
FROM ${PYTHON_IMAGE} AS dependencies
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN python -m venv /opt/venv
COPY deploy/aws/image/requirements-linux-cpu.lock /tmp/requirements.lock
RUN /opt/venv/bin/python -m pip install --require-hashes --no-compile -r /tmp/requirements.lock \
    && /opt/venv/bin/python -m pip check

FROM ${PYTHON_IMAGE} AS runtime
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HF_HOME=/models/huggingface HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 MALLOC_ARENA_MAX=2 \
    RAG_V2=1 RAG_V2_UPLOAD_DIR=/data/uploads RAG_OCR_TESSDATA=/models/tessdata
RUN groupadd --gid 10001 rag && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin rag \
    && mkdir -p /app /data/uploads /models/huggingface /models/tessdata \
    && chown -R 10001:10001 /app /data /models
COPY --from=dependencies /opt/venv /opt/venv
WORKDIR /app
COPY --chown=10001:10001 main.py /app/main.py
COPY --chown=10001:10001 backend /app/backend
COPY --chown=10001:10001 services /app/services
COPY --chown=10001:10001 scripts/run_v2_worker.py /app/scripts/run_v2_worker.py
COPY --chown=10001:10001 scripts/v2_admin.py /app/scripts/v2_admin.py
COPY --chown=10001:10001 migrations /app/migrations
COPY --chown=10001:10001 deploy/aws /app/deploy/aws
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.v2.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log", "--timeout-graceful-shutdown", "30"]
