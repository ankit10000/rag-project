[Unit]
Description=RAG demonstration private Compose services
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/rag/current
Environment=RAG_DEPLOY_ENV=/srv/rag/config/deployment.env
ExecStart=/bin/bash /srv/rag/current/release.sh start
ExecStop=/bin/bash /srv/rag/current/release.sh stop
TimeoutStartSec=240
TimeoutStopSec=420

[Install]
WantedBy=multi-user.target
