#!/usr/bin/env python3
"""Client-side Docker adapter for encrypted off-host restore via pinned SSH.

Put this directory first in PATH only for the reviewed backup/restore command.
No Docker context, AWS credential or decryption key is installed on the server.
"""
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

host=os.environ['RAG_RESTORE_SSH_HOST']
if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.@-]+',host):
    raise SystemExit('invalid restore SSH host')
identity=Path(os.environ['RAG_RESTORE_SSH_KEY']).resolve()
known=Path(os.environ['RAG_RESTORE_KNOWN_HOSTS']).resolve()
if not identity.is_file() or not known.is_file() or not known.stat().st_size:
    raise SystemExit('existing SSH identity and pinned host keys are required')
command=shlex.join(['sudo','-n','docker',*sys.argv[1:]])
raise SystemExit(subprocess.run(['ssh','-i',str(identity),'-o','BatchMode=yes',
    '-o','StrictHostKeyChecking=yes','-o',f'UserKnownHostsFile={known}',host,command]).returncode)
